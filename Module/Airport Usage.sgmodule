[Script]
AirportUsagePanel = type=generic,timeout=15,script-path=https://raw.githubusercontent.com/Vaerios/Nyora/refs/heads/Surge/Script/AirportUsage/AirportUsage.js?v=2,argument="{{{subscription_url}}}"

[Panel]
{{{display_name}}} = script-name=AirportUsagePanel,update-interval=600
