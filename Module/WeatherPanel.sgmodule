#!name=Weather Panel
#!desc=Today's weather forecast. Edit cityId in module parameters.
#!category=Panels
#!arguments=cityId:101220101
#!homepage=https://whatshub.top

[Panel]
Weather = script-name=Weather

[Script]
Weather = type=generic,script-path=https://raw.githubusercontent.com/YOUR_USERNAME/YOUR_REPOSITORY/main/Scripts/WeatherPanel.js,argument=icon=sun.max.fill&color=%23ffc400&cityId={{{cityId}}}
