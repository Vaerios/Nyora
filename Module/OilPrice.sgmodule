#!name=Oil Price
#!desc=实时油价查询
#!category=Panels
#!arguments=provname:安徽
#!arguments-desc=provname:填写省份名称，例如安徽、江苏、广东、浙江

[Panel]
今日油价 = script-name=OilPrice,update-interval=3600

[Script]
OilPrice = type=generic,timeout=15,script-path=https://raw.githubusercontent.com/YOUR_USERNAME/YOUR_REPOSITORY/main/Scripts/OilPricePanel.js,argument=icon=car&color=%23c932a9&provname={{{provname}}}
